# ---- Unity (UnityProject/) ----
UnityProject/[Ll]ibrary/
UnityProject/[Tt]emp/
UnityProject/[Oo]bj/
UnityProject/[Bb]uild/
UnityProject/[Bb]uilds/
UnityProject/[Ll]ogs/
UnityProject/[Uu]ser[Ss]ettings/
UnityProject/[Mm]emoryCaptures/
UnityProject/[Rr]ecordings/
UnityProject/.vs/
UnityProject/ExportedObj/
UnityProject/*.apk
UnityProject/*.aab
UnityProject/*.unitypackage
UnityProject/*.app
UnityProject/crashlytics-build.properties
# Unity writes the open scene here after a crash; it is a copy, not source
UnityProject/Assets/_Recovery/
UnityProject/Assets/_Recovery.meta

# Debug output of the smoke tools, rewritten on every run. Worth looking at, not worth
# a diff. Regenerate with The Movers > Smoke Preview, see tools/README.md.
UnityProject/Assets/_Movers/Generated/smoke/
UnityProject/Assets/_Movers/Generated/smoke.meta

# Unity-generated IDE / solution files (regenerated locally)
*.csproj
*.sln
*.slnx
*.user
*.userprefs
.vscode/

# ---- Builds / artefacts ----
/build/
/dist/
*.exe
*.pdb

# ---- OS / editeurs ----
.DS_Store
Thumbs.db
desktop.ini
.idea/
*.swp

# ---- Secrets ----
.env
*.local

# ---- Local MCP config (machine-specific paths; each dev copies .mcp.json.example) ----
.mcp.json

# ---- Unity baked lighting (large, regenerated on bake; e.g. asset-pack demo scenes) ----
UnityProject/Assets/**/LightingData.asset
UnityProject/Assets/**/LightingData.asset.meta

# ---- Blender backups (auto-saved copies of the .blend, not source) ----
*.blend1
